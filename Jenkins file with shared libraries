@Library("Shared") _
pipeline {
    agent { label "Shreshta" }

    stages {
        stage("Hello"){
            steps{
                script{
                    hello()
                }
            }
        }
        
        stage("Clone code") {
            steps {
               script{
                clone("https://github.com/shre-45/django-todo.git","develop")
               }
            }
        }    
        stage("Build") {
            steps {
                script{
                    docker_build("todo-app","latest","shreshtaanugu")
                }
            }
