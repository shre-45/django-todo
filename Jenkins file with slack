@Library("Shared") _
pipeline {
    agent any

    stages {
        stage("Hello"){
            steps{
                script{
                    hello()
                }
            }
        }
        
        stage("Clone code") {
            steps {
               script{
                clone("https://github.com/shre-45/django-todo.git","develop")
               }
            }
        }    
        stage("Build") {
            steps {
                script{
                    docker_build("todo-app","latest")
                }
            }
        }
        stage("Push to dockerhub") {
            steps {
               script{
                   docker_push("todo-app","latest","Devregistrys")
               }
                
            }
            
        }
        stage("Deploy") {
            steps {
                echo "Deploying the image"
                sh "docker-compose up -d"
            }
        }
    }    
    post {
    success {
        slackSend(
            channel: '#ci',
            color: 'good',
            message: " *Success* - Job '${env.JOB_NAME}'\nBuild_Number #${env.BUILD_NUMBER}\nMore info: ${env.BUILD_URL}"
        )
    }

    failure {
        slackSend(
            channel: '#ci',
            color: 'danger',
            message: "❌ *FAILURE* - Job `${env.JOB_NAME}` #${env.BUILD_NUMBER}\nCheck logs: ${env.BUILD_URL}"
        )
      } 
    }    

}
